
/* CAMPUS RDC - V1.0 */

document.addEventListener("DOMContentLoaded", () => {

  const $ = (selector) => document.querySelector(selector);
  const $$ = (selector) => [...document.querySelectorAll(selector)];

  // 1. NAVIGATION PRINCIPALE

  const views = {
    accueil: "homeSection",
    cours: "view-cours",
    agenda: "view-agenda",
    annonces: "view-annonces",
    profil: "view-profil"
  };

  function showView(name) {
    const target = views[name];

    if (!target) return;

    // Afficher les sections d'accueil
    ["homeSection", "coursesSection"].forEach(id => {
      const section = document.getElementById(id);
      if (section) {
        section.hidden = name !== "accueil";
      }
    });

    // Afficher les autres pages
    Object.entries(views).forEach(([key, id]) => {
      if (key === "accueil") return;

      const section = document.getElementById(id);
      if (section) {
        section.hidden = key !== name;
      }
    });

    // Mettre à jour les boutons actifs
    $$(".nav-link[data-view]").forEach(button => {
      button.classList.toggle(
        "active",
        button.dataset.view === name
      );
    });

    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  // Boutons de navigation
  $$(".nav-link[data-view]").forEach(button => {
    button.addEventListener("click", () => {
      showView(button.dataset.view);
    });
  });

  // Boutons "Voir tout", "Voir les cours", etc.
  $$("[data-go]").forEach(button => {
    button.addEventListener("click", () => {
      showView(button.dataset.go);
    });
  });

  // 2. MENU MOBILE

  const menuButton = $("#menuToggle");
  const menu = $("#mainNav");

  if (menuButton && menu) {
    menuButton.addEventListener("click", () => {
      menu.classList.toggle("open");

      const opened = menu.classList.contains("open");
      menuButton.setAttribute("aria-expanded", opened);
    });
  }

  // 3. PROFIL ETUDIANT

  const profileForm = $("#profileForm");
  const nameInput = $("#studentName");
  const universityInput = $("#studentUniversity");
  const facultyInput = $("#studentFaculty");
  const yearInput = $("#studentYear");
  const profileMessage = $("#profileMessage");

  // Charger les informations sauvegardées
  function loadProfile() {
    try {
      const profile = JSON.parse(
        localStorage.getItem("campusRdcProfile") || "{}"
      );

      if (nameInput) nameInput.value = profile.name || "";
      if (universityInput) universityInput.value = profile.university || "";
      if (facultyInput) facultyInput.value = profile.faculty || "";
      if (yearInput) yearInput.value = profile.year || "";

    } catch (error) {
      console.log("Profil non disponible.");
    }
  }

  loadProfile();

  // Enregistrer le profil
  if (profileForm) {
    profileForm.addEventListener("submit", (event) => {
      event.preventDefault();

      const profile = {
        name: nameInput?.value.trim() || "",
        university: universityInput?.value || "",
        faculty: facultyInput?.value.trim() || "",
        year: yearInput?.value.trim() || ""
      };

      try {
        localStorage.setItem(
          "campusRdcProfile",
          JSON.stringify(profile)
        );

        if (profileMessage) {
          profileMessage.textContent =
            "Votre profil a été enregistré avec succès !";
        }

      } catch (error) {
        if (profileMessage) {
          profileMessage.textContent =
            "Impossible d'enregistrer le profil.";
        }
      }
    });
  }

  // 4. RECHERCHE DES COURS

  const searchInput = $("#courseSearch, #searchInput, input[type='search']");
  const universityFilter = $("#universityFilter");

  function filterCourses() {
    const search = searchInput?.value.toLowerCase() || "";
    const university = universityFilter?.value || "";

    $$("#allCourses .course-card").forEach(card => {
      const matchesSearch =
        card.textContent.toLowerCase().includes(search);

      const matchesUniversity =
        !university ||
        card.dataset.university === university;

      card.hidden = !(matchesSearch && matchesUniversity);
    });
  }

  if (searchInput) {
    searchInput.addEventListener("input", filterCourses);
  }

  if (universityFilter) {
    universityFilter.addEventListener("change", filterCourses);
  }

  // 5. ANNEE AUTOMATIQUE

  const currentYear = $("#currentYear");

  if (currentYear) {
    currentYear.textContent = new Date().getFullYear();
  }

  console.log("CAMPUS RDC V1.0 est chargé !");
});
